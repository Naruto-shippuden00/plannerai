# Telegram Bot Token (BotFather'dan oling)
BOT_TOKEN=your_bot_token_here

# Hugging Face API Key (bepul - huggingface.co/settings/tokens)
# IXTIYORIY: AI vision analysis uchun. Bo'lmasa oddiy tasdiq ishlaydi
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Groq AI API Key (bepul - groq.com'dan oling) - OPTIONAL
